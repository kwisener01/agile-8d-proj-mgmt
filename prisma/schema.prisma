generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Sprint {
  id         String      @id
  name       String
  start      String
  end        String
  velocity   Int         @default(0)
  target     Int
  status     String
  agileItems AgileItem[]
}

model AgileItem {
  id             String  @id
  title          String
  type           String
  points         Int
  assignee       String
  col            String
  priority       String
  tags           String
  linkedDefectId String?
  sprintId       String?
  sprint         Sprint? @relation(fields: [sprintId], references: [id])
  defect         Defect? @relation(fields: [linkedDefectId], references: [id])
}

model Defect {
  id                String      @id
  title             String
  severity          String
  phase             String
  owner             String
  team              String
  created           String
  dueDate           String
  containment       String      @default("")
  rootCause         String      @default("")
  correctiveActions String      @default("")
  implementation    String      @default("")
  preventiveActions String      @default("")
  recognition       String      @default("")
  description       String
  bridged           Boolean     @default(false)
  isIsNot           String      @default("{}")
  fiveW2H           String      @default("{}")
  agileItems        AgileItem[]
  evidence          Evidence[]
}

model Member {
  id       String @id
  initials String @unique
  name     String @default("")
  email    String @default("")
  role     String @default("")
}

model Evidence {
  id         String @id
  defectId   String
  url        String
  caption    String @default("")
  phase      String @default("")
  uploadedAt String
  defect     Defect @relation(fields: [defectId], references: [id])
}
